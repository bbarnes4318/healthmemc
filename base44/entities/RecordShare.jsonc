{
  "name": "RecordShare",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "family_member_id": {
      "type": "string"
    },
    "share_medical_records": {
      "type": "boolean",
      "default": true
    },
    "share_appointments": {
      "type": "boolean",
      "default": true
    },
    "share_medications": {
      "type": "boolean",
      "default": false
    },
    "share_vitals": {
      "type": "boolean",
      "default": false
    },
    "share_recovery": {
      "type": "boolean",
      "default": false
    },
    "assigned_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "last_accessed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "recipient_email",
    "access_token",
    "expires_at"
  ]
}