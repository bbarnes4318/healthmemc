{
  "name": "ClinicianAccess",
  "type": "object",
  "properties": {
    "doctor_name": {
      "type": "string"
    },
    "doctor_email": {
      "type": "string"
    },
    "specialty": {
      "type": "string"
    },
    "access_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "share_records": {
      "type": "boolean",
      "default": true
    },
    "share_consultations": {
      "type": "boolean",
      "default": true
    },
    "share_medications": {
      "type": "boolean",
      "default": false
    },
    "share_vitals": {
      "type": "boolean",
      "default": false
    },
    "assigned_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accessed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "doctor_name",
    "doctor_email",
    "access_token",
    "expires_at"
  ]
}