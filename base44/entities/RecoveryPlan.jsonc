{
  "name": "RecoveryPlan",
  "type": "object",
  "properties": {
    "surgery_name": {
      "type": "string"
    },
    "surgeon": {
      "type": "string"
    },
    "hospital": {
      "type": "string"
    },
    "surgery_date": {
      "type": "string",
      "format": "date"
    },
    "expected_recovery_weeks": {
      "type": "number"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "target_day": {
            "type": "number"
          },
          "achieved_day": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "on_track",
              "achieved",
              "delayed"
            ],
            "default": "pending"
          }
        }
      }
    },
    "mobility_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week": {
            "type": "number"
          },
          "target_mobility": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "incision_care_instructions": {
      "type": "string"
    },
    "activity_restrictions": {
      "type": "string"
    },
    "weight_bearing_status": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "pt_prescription": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "family_member_id": {
      "type": "string"
    }
  },
  "required": [
    "surgery_name",
    "surgery_date"
  ]
}