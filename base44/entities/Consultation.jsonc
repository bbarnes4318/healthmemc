{
  "name": "Consultation",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "ai_doctor",
        "ai_nurse",
        "ai_specialist",
        "ai_dentist",
        "ai_veterinarian",
        "ai_physical_therapist",
        "ai_eye_doctor",
        "ai_ent",
        "ai_dermatologist",
        "ai_senior_care",
        "ai_assisted_living",
        "ai_sports_medicine",
        "ai_fitness",
        "ai_personal_physician",
        "ai_wellness_spa",
        "ai_er"
      ]
    },
    "specialty": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "escalated"
      ],
      "default": "in_progress"
    },
    "symptoms": {
      "type": "string"
    },
    "conversation_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "diagnoses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "confidence": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "recommended_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_treatments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "medication_review": {
          "type": "string"
        },
        "lifestyle_recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "complementary_care": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "follow_up_plan": {
          "type": "string"
        },
        "emergency_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "emergency"
      ]
    },
    "avatar_gender": {
      "type": "string"
    },
    "avatar_race": {
      "type": "string"
    },
    "patient_context_summary": {
      "type": "string"
    },
    "data_points_used": {
      "type": "number"
    },
    "family_member_id": {
      "type": "string"
    }
  },
  "required": [
    "type"
  ]
}