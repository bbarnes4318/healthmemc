{
  "name": "PTDailyGoal",
  "type": "object",
  "properties": {
    "daily_exercise_count": {
      "type": "number",
      "default": 3
    },
    "daily_rom_target": {
      "type": "number"
    },
    "rom_body_part": {
      "type": "string",
      "enum": [
        "knee",
        "shoulder",
        "hip",
        "spine",
        "ankle",
        "wrist",
        "neck",
        "full_body",
        "other"
      ]
    },
    "daily_duration_minutes": {
      "type": "number",
      "default": 30
    },
    "family_member_id": {
      "type": "string"
    }
  },
  "required": [
    "daily_exercise_count"
  ]
}