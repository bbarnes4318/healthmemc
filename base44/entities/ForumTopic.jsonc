{
  "name": "ForumTopic",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "surgery_options",
        "treatment_methods",
        "care_plans",
        "medication_review",
        "diagnostic_approaches",
        "case_discussion",
        "general"
      ],
      "default": "general"
    },
    "specialty": {
      "type": "string",
      "enum": [
        "cardiology",
        "orthopedics",
        "neurology",
        "oncology",
        "pediatrics",
        "surgery",
        "internal_medicine",
        "emergency_medicine",
        "psychiatry",
        "obstetrics_gynecology",
        "dermatology",
        "radiology",
        "anesthesiology",
        "ent",
        "ophthalmology",
        "urology",
        "gastroenterology",
        "endocrinology",
        "nephrology",
        "pulmonology",
        "rheumatology",
        "dentistry",
        "veterinary_medicine",
        "general"
      ],
      "default": "general"
    },
    "author_name": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "doctor",
        "specialist",
        "nurse",
        "dentist",
        "veterinarian"
      ]
    },
    "author_specialty": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "views": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "content",
    "category",
    "author_role"
  ]
}