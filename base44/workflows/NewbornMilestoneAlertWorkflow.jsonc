{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Newborn Milestone Alert Workflow",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "newborn_milestone_alert_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_milestones": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "newbornMilestoneAlert",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check newborn milestones and growth",
            "description": "Email users when their baby hits developmental milestones or falls behind on growth markers"
          }
        }
      }
    ]
  },
  "description": "Daily check of newborn milestones and growth measurements \u2014 emails users when new milestones are logged or when growth measurements fall below WHO 3rd percentile thresholds"
}