{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Missed Medication Alert Workflow",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "missed_medication_alert_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_missed_meds": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkMissedMedications",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check missed medications",
            "description": "Alert caregivers for doses missed >2 hours"
          }
        }
      }
    ]
  },
  "description": "Scans every 30 minutes for medications marked as missed for more than 2 hours and sends detailed alerts to designated caregivers"
}