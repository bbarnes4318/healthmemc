{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dental_checkup_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dentalCheckupReminder",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send dental checkup reminders",
            "description": "Emails users overdue for 6-month checkup"
          }
        }
      }
    ]
  },
  "description": "Daily check for users whose last dental visit was 6+ months ago; sends an email reminder to schedule a checkup.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Dental Checkup Reminder Workflow"
}