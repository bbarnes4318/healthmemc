  },
  "name": "Pet Medication Reminder Workflow",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pet_medication_reminder_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_pet_medications": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "petMedicationReminder",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check pet medication schedules",
            "description": "Scan for active medications due today and email owners"
          }
        }
      }
    ]
  },
  "description": "Daily check for pet medications due today \u2014 sends email alerts to pet owners to give and log doses"
}